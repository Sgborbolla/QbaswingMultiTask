<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- PLAN.md seccion 1: el exe de escritorio es QbaswingMultiTask.exe,
         no QbaswingMultiTask.Desktop.exe. -->
    <AssemblyName>QbaswingMultiTask</AssemblyName>
    <RootNamespace>QbaswingMultiTask.Desktop</RootNamespace>
    <ApplicationIcon>Assets\logo-qbaswing.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fijado a 11.3.5: es la version disponible en la carpeta local "paquetes".
         La plantilla de Avalonia genera 12.1.3, que aqui no se puede restaurar. -->
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QbaswingMultiTask.Core\QbaswingMultiTask.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\*" />
  </ItemGroup>

</Project>